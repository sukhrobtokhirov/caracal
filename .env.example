# M0 scaffolding: one development PostgreSQL database.
# Copy to .env.local (git-ignored) and export it before running the server.
# Replaced by the encrypted connection store in M1.
DBIDE_DEV_POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# Optional: a throwaway database for the opt-in PostgreSQL integration test.
DBIDE_TEST_POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
